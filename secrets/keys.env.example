# ─────────────────────────────────────────────────────────────────────────
# THE canonical list of every credential the assistant stack uses.
# Copy to secrets/.env (gitignored), fill it in once, and it becomes the
# single source for:
#
#   • local development      set -a && . secrets/.env && set +a
#   • GitHub secrets         scripts/sync-github-secrets.sh
#   • the cluster            scripts/create-harness-secret.sh
#
# NOTE ON TESTS: the test suites in all three repos are fully stubbed and
# need NO real credentials. Do not put vendor keys in a repo's Actions
# secrets just to make CI pass -- CI already passes without them. The only
# place real values are needed is the Seal Secrets workflow in THIS repo.
# ─────────────────────────────────────────────────────────────────────────

# ── Cloudflare AI Gateway ────────────────────────────────────────────────
CF_ACCOUNT_ID=
CF_AI_GATEWAY=home-harness
CF_AI_GATEWAY_TOKEN=

# ── Model vendors — only the ones apps/harness/models.yaml names ─────────
# platform.claude.com → Settings → API keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
CF_WORKERS_AI_TOKEN=
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=

# ── Home Assistant ───────────────────────────────────────────────────────
# HA → your user → Security → Long-lived access tokens
HA_URL=http://192.168.1.117:8123
HA_TOKEN=

# ── Google Calendar ──────────────────────────────────────────────────────
# python3 scripts/google_oauth.py --client-id ... --client-secret ...
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# ── Internal service auth ────────────────────────────────────────────────
# Bearer token Open WebUI presents to the tool server. openssl rand -hex 24
TOOLS_API_KEY=
# Signs Open WebUI's sessions. Must stay stable, or every restart logs
# everyone out. openssl rand -hex 32
WEBUI_SECRET_KEY=
